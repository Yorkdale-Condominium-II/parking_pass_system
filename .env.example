# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database ---
# Full connection string OR individual PG* vars below.
DATABASE_URL=postgres://condo:condo@localhost:5432/parking_pass_system

# --- Security secrets (generate strong random values in production) ---
# openssl rand -hex 32
JWT_SECRET=replace-me-with-a-long-random-string
# Separate secret used only for signing barcode payloads (HMAC-SHA256).
BARCODE_SECRET=replace-me-with-a-different-long-random-string

# Secret for the rotating weekly override code (falls back to BARCODE_SECRET).
OVERRIDE_SECRET=replace-me-with-another-long-random-string

# --- Policy ---
# Visitor passes per RESIDENTIAL unit per calendar year.
ANNUAL_PASS_QUOTA=10
# Visitor passes per COMMERCIAL unit per calendar year (-1 = unlimited).
COMMERCIAL_PASS_QUOTA=20
# Hard cap on the number of residential units (building has 1520).
RESIDENTIAL_UNIT_CAP=1520
# Number of physical visitor parking spaces (max passes live at once).
SPOT_CAPACITY=5
# Default validity window for a visitor pass, in hours (used when no preset).
DEFAULT_PASS_DURATION_HOURS=24

# --- Email (optional) -------------------------------------------------------
# When set, approved resident requests are emailed to the resident with a PDF
# pass attached. Leave unset to disable email (approval still works).
# Option A — single URL (e.g. Gmail with an App Password):
#   SMTP_URL=smtps://you@gmail.com:your-app-password@smtp.gmail.com:465
# Option B — discrete settings:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-app-password
# Address shown as the sender:
#   MAIL_FROM=Yorkdale Parking <parking@yourbuilding.com>

# --- Single sign-on (optional) ----------------------------------------------
# Public URL the app is reached at (used to build OAuth redirect URIs).
# For a local install this is fine as-is.
OAUTH_BASE_URL=http://localhost:3000
# Google: create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <OAUTH_BASE_URL>/api/auth/sso/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Microsoft (Entra ID): register an app at https://entra.microsoft.com
# Redirect URI: <OAUTH_BASE_URL>/api/auth/sso/microsoft/callback
# MICROSOFT_TENANT=common
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# --- Google Sheets mirror (optional) ----------------------------------------
# When set, every pass event (issued / revoked / vacated) is POSTed to a Google
# Apps Script web app that appends a row to a Google Sheet. Leave unset to
# disable. See docs/GOOGLE_SHEETS.md for the 5-minute setup + script to paste.
# SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/AKfy.../exec
# Optional shared secret the script checks to reject unauthorized posts:
# SHEETS_WEBHOOK_TOKEN=some-long-random-string
