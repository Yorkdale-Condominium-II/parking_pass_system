# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database ---
# Full connection string OR individual PG* vars below.
DATABASE_URL=postgres://condo:condo@localhost:5432/parking_pass_system

# --- Security secrets (generate strong random values in production) ---
# openssl rand -hex 32
JWT_SECRET=replace-me-with-a-long-random-string
# Separate secret used only for signing barcode payloads (HMAC-SHA256).
BARCODE_SECRET=replace-me-with-a-different-long-random-string

# --- Policy ---
# Maximum visitor passes a single unit may be issued per calendar year.
ANNUAL_PASS_QUOTA=10
# Default validity window for a visitor pass, in hours.
DEFAULT_PASS_DURATION_HOURS=24
