# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database ---
# Full connection string OR individual PG* vars below.
DATABASE_URL=postgres://condo:condo@localhost:5432/parking_pass_system

# --- Security secrets (generate strong random values in production) ---
# Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# (or: openssl rand -hex 32). NEVER commit the real .env — it is gitignored and
# a pre-commit hook (.githooks/pre-commit) refuses to stage it.
JWT_SECRET=<GENERATE-NEW>
# Separate secret used only for signing barcode payloads (HMAC-SHA256).
# NOTE: rotating BARCODE_SECRET invalidates every already-issued pass barcode.
BARCODE_SECRET=<GENERATE-NEW>

# Secret for the rotating weekly override code (falls back to BARCODE_SECRET).
OVERRIDE_SECRET=<GENERATE-NEW>

# --- Policy ---
# Visitor passes per RESIDENTIAL unit per calendar year.
ANNUAL_PASS_QUOTA=10
# Visitor passes per COMMERCIAL unit per calendar year (-1 = unlimited).
COMMERCIAL_PASS_QUOTA=20
# Hard cap on the number of residential units (building has 1520).
RESIDENTIAL_UNIT_CAP=1520
# Number of physical visitor parking spaces (max passes live at once).
SPOT_CAPACITY=5
# Default validity window for a visitor pass, in hours (used when no preset).
DEFAULT_PASS_DURATION_HOURS=24

# --- Email (optional) -------------------------------------------------------
# When set, approved resident requests are emailed the pass PDF, and the
# "forgot password" feature can send reset links. Leave unset to disable email
# (approval and the app still work; reset then requires recover-admin.bat).
#
# Building account: yorkdalecondominiumii@gmail.com  (a personal @gmail.com, so
# it CAN create an App Password — unlike a Google Workspace account).
#   1) Turn on 2-Step Verification: https://myaccount.google.com/security
#   2) Create an App Password ("Mail"): https://myaccount.google.com/apppasswords
#   3) Paste the 16-character App Password (no spaces) below as SMTP_PASS.
#
# Uncomment these four lines and fill in the App Password:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=yorkdalecondominiumii@gmail.com
#   SMTP_PASS=your-16-char-app-password
# Address shown as the sender:
#   MAIL_FROM=Yorkdale Condominium II <yorkdalecondominiumii@gmail.com>

# --- Single sign-on (optional) ----------------------------------------------
# Public URL the app is reached at (used to build OAuth redirect URIs).
# For a local install this is fine as-is.
OAUTH_BASE_URL=http://localhost:3000
# Google: create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <OAUTH_BASE_URL>/api/auth/sso/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Microsoft (Entra ID): register an app at https://entra.microsoft.com
# Redirect URI: <OAUTH_BASE_URL>/api/auth/sso/microsoft/callback
# MICROSOFT_TENANT=common
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# --- Google Sheets mirror (optional) ----------------------------------------
# When set, every pass event (issued / revoked / vacated) is POSTed to a Google
# Apps Script web app that appends a row to a Google Sheet. Leave unset to
# disable. See docs/GOOGLE_SHEETS.md for the 5-minute setup + script to paste.
# SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/AKfy.../exec
# Optional shared secret the script checks to reject unauthorized posts:
# SHEETS_WEBHOOK_TOKEN=some-long-random-string

# --- Data-deletion backup (optional override) -------------------------------
# Before management clears logs / year-end / full reset, a full Excel backup of
# all data is emailed to an oversight contact (requires the email settings above
# to be configured). The recipient is hidden in the app by default; set this to
# override it.
# ARCHIVE_EMAIL=someone@example.com

# --- Locale / TLS -----------------------------------------------------------
# Property timezone (IANA name) used for pass expiry, "rest of today", and the
# calendar-year quota. Defaults to America/Toronto.
# PROPERTY_TZ=America/Toronto
# Send the session cookie only over HTTPS. Set true when serving over TLS.
# COOKIE_SECURE=true

# --- Reverse proxy ----------------------------------------------------------
# Trust this many reverse proxies for X-Forwarded-For (default 0 = no trust).
# Set to 1 if behind a single TLS terminator that sets X-Forwarded-For.
# Only enable this when the proxy STRIPS a client-supplied X-Forwarded-For
# header, otherwise clients can spoof their IP (rate-limit / audit evasion).
# TRUST_PROXY=1
