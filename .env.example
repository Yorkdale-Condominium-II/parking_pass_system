# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database ---
# Full connection string OR individual PG* vars below.
DATABASE_URL=postgres://condo:condo@localhost:5432/parking_pass_system

# --- Security secrets (generate strong random values in production) ---
# openssl rand -hex 32
JWT_SECRET=replace-me-with-a-long-random-string
# Separate secret used only for signing barcode payloads (HMAC-SHA256).
BARCODE_SECRET=replace-me-with-a-different-long-random-string

# Secret for the rotating weekly override code (falls back to BARCODE_SECRET).
OVERRIDE_SECRET=replace-me-with-another-long-random-string

# --- Policy ---
# Visitor passes per RESIDENTIAL unit per calendar year.
ANNUAL_PASS_QUOTA=10
# Visitor passes per COMMERCIAL unit per calendar year (-1 = unlimited).
COMMERCIAL_PASS_QUOTA=20
# Hard cap on the number of residential units (building has 1520).
RESIDENTIAL_UNIT_CAP=1520
# Default validity window for a visitor pass, in hours (used when no preset).
DEFAULT_PASS_DURATION_HOURS=24
